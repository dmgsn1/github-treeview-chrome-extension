{
  "name": "github-tree",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Chrome side-panel tree of the GitHub items you have open",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e/run.js && node test/e2e/stale-worker.js",
    "shots": "node test/e2e/run.js --shots docs",
    "check": "node --check src/*.js sidepanel/*.js && npm test && npm run e2e"
  },
  "devDependencies": {
    "@octokit/graphql-schema": "^15.26.1",
    "graphql": "^16.11.0",
    "playwright": "1.56.1"
  }
}
